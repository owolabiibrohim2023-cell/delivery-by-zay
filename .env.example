# ============================================================
# D3Z Frontend — environment variables (Vite)
# Copy to .env (or .env.local) and fill in as needed.
# ============================================================

# Base URL of the D3Z FastAPI backend, WITHOUT a trailing slash.
#
#  • Leave EMPTY (or omit) to run the frontend in demonstration mode
#    with clearly-labelled mock/sample data (recommended for design work).
#
#  • Local backend:   http://localhost:8000
#    (During `npm run dev` you can also leave it empty — the Vite dev
#    server proxies /api/* to http://127.0.0.1:8000 automatically.)
#
#  • Production:      https://d3z-api.onrender.com  (your Render URL)
#
# When set, every service in src/services/* switches from mock data to
# live FastAPI endpoints (JWT auth included).
VITE_API_BASE_URL=
